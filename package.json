{
  "name": "ticktick",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @ticktick/web dev",
    "build": "pnpm --filter @ticktick/web build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "lint": "pnpm --filter @ticktick/web lint",
    "e2e": "pnpm --filter @ticktick/e2e e2e",
    "test:api": "cd apps/api && uv run pytest"
  }
}
