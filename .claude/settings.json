{
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1"
  },
  "teammateMode": "auto",
  "permissions": {
    "allow": [
      "Read",
      "Grep",
      "Glob",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(pnpm test *)",
      "Bash(pnpm typecheck *)",
      "Bash(pnpm lint *)",
      "Bash(pnpm --filter * test *)",
      "Bash(pnpm --filter * typecheck *)",
      "Bash(pnpm --filter * lint *)"
    ],
    "deny": [
      "Bash(rm -rf *)"
    ]
  }
}
