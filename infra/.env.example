# Copie para infra/.env e preencha. Nunca coloque o .env no git.

# Domínio do app. "localhost" para testar na própria máquina (o navegador vai avisar do certificado);
# um domínio público apontando para o servidor para HTTPS de verdade (Let's Encrypt).
DOMINIO=localhost

# Senha do PostgreSQL (só letras e números, para não precisar escapar na URL de conexão).
POSTGRES_SENHA=troque-esta-senha

# Portas publicadas no servidor.
PORTA_HTTP=80
PORTA_HTTPS=443

# Onde os backups diários ficam (pasta do servidor).
PASTA_BACKUP=./backups
