# Copie para infra/.env e preencha. Nunca coloque o .env no git.

# Domínio do app:
#  - PC em casa com Tailscale (recomendado, ver README): DOMINIO=:80 e as portas presas ao 127.0.0.1 (abaixo);
#    o HTTPS fica com o `tailscale serve --bg 8080`.
#  - VPS com domínio público: o domínio (HTTPS automático pela Let's Encrypt) e portas 80/443.
#  - "localhost" para testar (o navegador avisa do certificado).
DOMINIO=:80

# Senha do PostgreSQL (só letras e números, para não precisar escapar na URL de conexão).
POSTGRES_SENHA=troque-esta-senha

# Portas publicadas. Com Tailscale: só no próprio PC. Com VPS e domínio: 80 e 443.
PORTA_HTTP=127.0.0.1:8080
PORTA_HTTPS=127.0.0.1:8443

# Onde os backups diários ficam (pasta do servidor).
PASTA_BACKUP=./backups
